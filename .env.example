# All optional. With none set, the app runs fully offline using the rule-based LLM + typed transcripts.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=          # only for /transcribe (Whisper)
STT_MODEL=whisper-1
API_KEY=                 # if set, every endpoint requires header X-API-Key
